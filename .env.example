# Copy to .env and edit. Everything here can also be set as a normal environment variable.

# Your Postgres (it can be on another machine). Create an empty UTF8 database first, for example:  createdb -E UTF8 -T template0 storefront
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storefront

# On start, create the tables (SQLAlchemy create_all, plus columns new in the models) and fill an empty database with the demo accounts, products and orders.
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true

# Where the frontend runs (comma separated). Use * to allow any origin while you demo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs the login tokens. Set your own long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-sharing-this-server
ACCESS_TOKEN_MINUTES=720

# SQLite files for the admin portal's "SQLite" import source must be inside this folder.
IMPORT_SQLITE_DIR=./data/import
